<Window x:Class="Shaiya_Invasion_Updater.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="224" WindowStartupLocation="CenterScreen" WindowStyle="None"
        ResizeMode="NoResize" Icon="Resources/icon.ico">
  <Control.Background>
    <ImageBrush ImageSource="Resources/content.png"/>
  </Control.Background>
  <FrameworkElement.Resources>
    <FontFamily x:Key="CrimsonTextRoman">
      Georgia
    </FontFamily>
  </FrameworkElement.Resources>
  <Grid>
    <Rectangle MouseLeftButtonDown="DragWindow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Shape.Fill>
        <SolidColorBrush Color="Transparent"/>
      </Shape.Fill>
    </Rectangle>
    <Grid Name="TitleGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="720" Height="68">
      <TextBlock MouseLeftButtonDown="DragWindow" Name="TextBlockTitle" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Foreground="#7A6754" FontFamily="{StaticResource CrimsonTextRoman}"
                 FontSize="24"/>
    </Grid>
    <Grid Name="TextGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="720" Height="86"
          Margin="0, 68, 0, 0">
      <TextBlock MouseLeftButtonDown="DragWindow" Name="TextBlockText" TextWrapping="Wrap" MaxWidth="700"
                 TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7A6754"
                 FontFamily="{StaticResource CrimsonTextRoman}" FontSize="20"/>
    </Grid>
    <Grid Name="ButtonsGrid" HorizontalAlignment="Stretch" VerticalAlignment="Top" Width="720" Height="70"
          Margin="0, 154, 0, 0">
      <WrapPanel Name="ButtonContainer" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FlowDirection="LeftToRight"/>
    </Grid>
  </Grid>
</Window>