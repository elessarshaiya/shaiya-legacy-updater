<UserControl x:Class="Shaiya_Invasion_Updater.iButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             MouseEnter="UserControl_MouseEnter" MouseLeave="UserControl_MouseLeave"
             MouseLeftButtonDown="UserControl_MouseLeftButtonDown"
             MouseLeftButtonUp="UserControl_MouseLeftButtonUp" Width="100" Height="30" Cursor="Hand">
  <Control.Background>
    <ImageBrush ImageSource="Resources/button.png"/>
  </Control.Background>
  <Grid>
    <TextBlock Name="TextBlockButtonText" HorizontalAlignment="Center" VerticalAlignment="Center"
               Foreground="#7A6754" FontFamily="Georgia" FontSize="18"/>
  </Grid>
</UserControl>