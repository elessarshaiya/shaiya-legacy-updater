<UserControl x:Class="Shaiya_Invasion_Updater.ProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Width="900" Height="40">
  <Control.Background>
    <ImageBrush ImageSource="Resources/progress_bar_container.png"/>
  </Control.Background>
  <Grid>
    <Image Name="ProgressImage" Source="Resources/progress_bar.png" HorizontalAlignment="Left" Stretch="None"/>
  </Grid>
</UserControl>